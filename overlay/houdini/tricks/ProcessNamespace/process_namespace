name: host_network_namespace
dockerfile:
  - path: Dockerfile
dependencies:
  - server: True
docker_config: 
  - network_mode: bridge
  - read_only: False
  - security_opt: []
  - pid_mode: null
  - cpu_shares: null
  - volumes: null
  - mem_limit: null
  - cpuset_cpus: null
  - cpu_quota: null
  - cpu_period: null
  - cap_add: ["CAP_SYS_PTRACE"]
  - cap_drop: []
  - privileged: True
  - user: root
  - pids_limit: null
  - ipc_mode: null
trick:
  - path: /houdini/tricks/ProcessNamespace