name: cpu_shares
dockerfile:
  - path: Dockerfile
dependencies:
  - server: False
docker_config: 
  - network_mode: bridge
  - read_only: True
  - security_opt: []
  - pid_mode: null
  - cpu_shares: 512
  - volumes : []
  - mem_limit: null
  - cpuset_cpus: null
  - cpu_quota: null
  - cpu_period: null
  - cap_add: ["NET_BIND_SERVICE"]
  - cap_drop: []
  - privileged: False
  - user: root
  - pids_limit: null
  - ipc_mode: null
  - userns_mode: null
trick:
  - path: /houdini/tricks/PrivilegedPorts